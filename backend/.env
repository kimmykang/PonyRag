# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
# 模型保留时间：keep_alive 控制模型在显存中保留多久（默认5分钟）
# 设置更长时间可避免重复冷启动，-1 表示永久保留
OLLAMA_KEEP_ALIVE=30m

# 模型配置（在 ollama 中拉取对应模型即可）
# 对话模型：llama3、qwen2、mistral 等
CHAT_MODEL=qwen3.5:9b
# 问题改写模型：用于多轮对话补全省略指代，建议配置轻量小模型（如 qwen3:1.7b）
# 留空则使用 CHAT_MODEL；注意：与 CHAT_MODEL 相同时 num_ctx 必须一致，否则 Ollama 会卸载重载
# REWRITE_MODEL=qwen3:1.7b
# 嵌入模型：nomic-embed-text、mxbai-embed-large 等
EMBED_MODEL=qwen3-embedding:8b
# Rerank 模型：cross-encoder/cross-encoder/ms-marco-MiniLM-L-6-v2 或通过 ollama 拉取
RERANK_MODEL=MedAIBase/Qwen3-VL-Reranker:2b

# Rerank 方式：
#   ollama        — 使用 RERANK_MODEL 通过 Ollama 推理（embed 或 generate+logprob，自动判断）
#   cross_encoder — 使用本地 HuggingFace CrossEncoder（需要 sentence_transformers + CUDA 加速）
#   listwise      — 使用 CHAT_MODEL 做 Listwise 批量排序（精度高但速度慢，适合小模型）
#   none          — 禁用 rerank，仅按向量相似度排序
#
#   以上三种方法（ollama/cross_encoder/listwise）失败后均自动降级到向量相似度排序（不中断请求）
RERANK_METHOD=none

# CrossEncoder 本地模型名（RERANK_METHOD=cross_encoder 时生效）
# 模型会自动缓存到 HuggingFace hub 缓存目录，首次使用会自动下载
# 推荐：BAAI/bge-reranker-v2-m3（中英双语，567M，GPU 推理 ~0.1s/6doc）
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3

# CrossEncoder 运行设备（RERANK_METHOD=cross_encoder 时生效）
# gpu  — 强制 GPU（推荐：启动时先占显存，后加载 Ollama 大模型，避免显存竞争）
# cpu  — 强制 CPU（显存不足时使用，推理约 0.5~2s/6doc）
# auto — 有 CUDA 则 GPU，否则 CPU（默认）
CROSS_ENCODER_DEVICE=auto

# 禁用 HuggingFace Hub 在线检查（模型已本地缓存，无需联网验证版本）
# 消除 "unauthenticated requests to the HF Hub" 警告
HF_HUB_OFFLINE=1

# OCR 视觉模型：用于提取图片型 PDF/扫描件文字，需支持视觉输入（如 qwen2.5vl:7b、minicpm-v）
# 留空则禁用 OCR 功能
OCR_MODEL=glm-ocr:latest

# 向量数据库
VECTOR_DB_PATH=./vector_db

# 文档上传目录
UPLOAD_DIR=./uploads

# 服务器配置
HOST=0.0.0.0
PORT=8001

# 检索参数
TOP_K=6
RERANK_TOP_K=4
# qwen3-embedding:8b 支持长文（4096维），chunk_size 提升到 1000 保留更完整的语义单元
# chunk_overlap 设为 chunk_size 的 15%，防止边界语义丢失
# 推荐值参考：
#   qwen3-embedding:0.6b / 1.7b → CHUNK_SIZE=500~800,  CHUNK_OVERLAP=75~120
#   qwen3-embedding:4b          → CHUNK_SIZE=800~1200, CHUNK_OVERLAP=120~180
#   qwen3-embedding:8b          → CHUNK_SIZE=1000~1500,CHUNK_OVERLAP=150~225
#   nomic-embed-text / bge-m3  → CHUNK_SIZE=400~600,  CHUNK_OVERLAP=60~90
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# 文档分块方式：recursive（默认）| markdown（标题树）| semantic（语义切分）
CHUNK_METHOD=auto
CONTEXT_LIMIT=26000
# Ollama 上下文窗口大小（token 数），所有调用统一用此值
# 同一模型不同 num_ctx 会触发 Ollama 完整卸载重载，务必保持一致
# qwen3.6:27b 最大支持 131072；显存紧张时可调小到 32768
NUM_CTX=131072
THINKING=false
# 启动时自动索引（断点续传）：true=启动时自动将未入库的 .md 文件向量化，false=关闭（默认）
STARTUP_INGEST=false

# 标题核心词提取的通用尾部词表（用于 _expand_by_title 的标题匹配）
# 标题末尾出现这些词时，去掉后用核心部分与用户问题做匹配
# 多个词用英文逗号分隔，可根据知识库领域自定义
# 例如法律领域可加：办法,章程,细则,公告,通知
# 留空则禁用核心词提取，直接用完整标题匹配
TITLE_GENERIC_SUFFIXES=清单,列表,明细,目录,说明,介绍,概述,详情,内容,信息,规定,条款,须知,规则
