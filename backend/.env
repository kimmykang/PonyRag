# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# 模型配置（在 ollama 中拉取对应模型即可）
# 对话模型：llama3、qwen2、mistral 等
CHAT_MODEL=qwen3.6:27b
# 嵌入模型：nomic-embed-text、mxbai-embed-large 等
EMBED_MODEL=qwen3-embedding:4b
# Rerank 模型：cross-encoder/cross-encoder/ms-marco-MiniLM-L-6-v2 或通过 ollama 拉取
RERANK_MODEL=qllama/bge-reranker-v2-m3:f16

# OCR 视觉模型：用于提取图片型 PDF/扫描件文字，需支持视觉输入（如 qwen2.5vl:7b、minicpm-v）
# 留空则禁用 OCR 功能
OCR_MODEL=qwen2.5vl:7b

# 向量数据库
VECTOR_DB_PATH=./vector_db

# 文档上传目录
UPLOAD_DIR=./uploads

# 服务器配置
HOST=0.0.0.0
PORT=8001

# 检索参数
TOP_K=6
RERANK_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 文档分块方式：recursive（默认）| markdown（标题树）| semantic（语义切分）
CHUNK_METHOD=recursive
